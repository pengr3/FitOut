# Copy to .env.preview.local. Never copy the production environment here.
VERCEL_ENV=preview
BACKGROUND_EXECUTION_MODE=events
# Both must target br-silent-glade-b31mruln/neondb; direct or pooled URLs are accepted.
PREVIEW_DATABASE_URL=
DATABASE_URL=
PREVIEW_SEED_PASSWORD=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=
MARKETING_APP_URL=
OPS_APP_URL=
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYOUT_DISPATCH_MODE=hold
INNGEST_ENV=preview-sandbox
INNGEST_DEV=0
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
DIDIT_ENVIRONMENT=sandbox
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Exact comma-separated tester addresses. Empty means no preview email is sent.
PREVIEW_EMAIL_RECIPIENTS=
CONTACT_ALERT_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=

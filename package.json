{
  "name": "fitout",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "dev": "next dev",
    "dev:inngest": "npx inngest-cli@latest dev",
    "build": "npm run lint && npm run test:design && next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:test:setup": "tsx scripts/db-test-setup.ts",
    "db:studio": "drizzle-kit studio",
    "design:tokens": "node scripts/generate-design-tokens.mjs",
    "fixtures:images": "node scripts/generate-image-fixtures.mjs",
    "cloudinary:preset": "tsx scripts/cloudinary-preset.ts",
    "email:previews": "tsx scripts/send-email-previews.ts",
    "ops:alerts": "tsx scripts/ops-alerts.ts list",
    "ops:alerts:resolve": "tsx scripts/ops-alerts.ts resolve",
    "ops:alerts:history": "tsx scripts/ops-alerts.ts history",
    "test": "vitest run",
    "test:design": "vitest run --config vitest.design.config.ts",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/patch-kysely-adapter.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@types/leaflet": "^1.9.21",
    "better-auth": "^1.6.14",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "inngest": "^4.13.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "next-cloudinary": "^6.17.5",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-easy-crop": "^6.2.3",
    "react-hook-form": "^7.77.0",
    "react-leaflet": "^5.0.0",
    "resend": "^6.12.4",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/culori": "^4.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "culori": "^4.0.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "tsx": "4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}

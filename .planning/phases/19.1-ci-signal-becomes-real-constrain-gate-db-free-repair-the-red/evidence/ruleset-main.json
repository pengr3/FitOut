{
  "name": "main — the four behaviour gates",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "required_status_checks": [
          {
            "context": "gate-e2e (functional Playwright suite)"
          },
          {
            "context": "gate-db-free (lint + design + build + workflow parse)"
          },
          {
            "context": "gate-db (vitest against PostGIS 18)"
          },
          {
            "context": "gate-price-parity (DB-vs-DOM price, 1 spec)"
          }
        ],
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false
      }
    }
  ],
  "bypass_actors": []
}
